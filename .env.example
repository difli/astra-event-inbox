# =============================================================================
# .env.example – copy to .env and fill in your values
# Never commit the real .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Astra DB
# ---------------------------------------------------------------------------
# Path to the Secure Connect Bundle ZIP on the HOST machine
# (the compose file mounts this into the container)
ASTRA_SECURE_BUNDLE_PATH_HOST=/path/to/secure-connect-your-db.zip

# Astra DB service account credentials (from the Astra console)
ASTRA_CLIENT_ID=your-client-id
ASTRA_CLIENT_SECRET=your-client-secret

# Keyspace (must already exist in Astra)
ASTRA_KEYSPACE=tds_inbox

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=astra-event-inbox
KAFKA_TOPIC=cloud-events
KAFKA_DLT_TOPIC=cloud-events.DLT
KAFKA_MAX_POLL_RECORDS=100
KAFKA_CONSUMER_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Inbox tuning
# ---------------------------------------------------------------------------
# Time-window size in seconds (must match the drainer when Phase 2 is added)
INBOX_WINDOW_SIZE_SECONDS=5

# ---------------------------------------------------------------------------
# Astra write mode
# ---------------------------------------------------------------------------
# async=false (default): synchronous writes — safer, easier to reason about,
#   but throughput is limited by round-trip latency to Astra (~28 R/s from Europe
#   to AWS us-east-2).
# async=true: fire-and-forget writes with a semaphore cap of maxInFlight per
#   consumer thread. Significantly higher throughput when Astra is remote.
#   Risk: an in-flight write that fails after the Kafka offset is committed
#   will be lost (not retried). Only enable when throughput matters more than
#   guaranteed durability.
INBOX_ASYNC_WRITES=false
# Max concurrent in-flight async writes per consumer thread.
# Effective only when INBOX_ASYNC_WRITES=true.
# Rule of thumb: ceil(target_rate / (concurrency * (1000 / rtt_ms)))
# Example: 2000 msg/s, concurrency=3, RTT=100ms → ceil(2000/(3*(1000/100))) = 7
INBOX_MAX_IN_FLIGHT_WRITES=8

# ---------------------------------------------------------------------------
# Astra retry / backoff (for rate-limit and transient errors)
# ---------------------------------------------------------------------------
ASTRA_RETRY_MAX_ATTEMPTS=5
ASTRA_RETRY_BASE_DELAY_MS=100
ASTRA_RETRY_MAX_DELAY_MS=5000
